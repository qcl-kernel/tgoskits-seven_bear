Set Shell bash
Set FontSize 18
Set FontFamily "Hack"
Set Width 1280
Set Height 720
Set Padding 24
Set Framerate 30
Set LetterSpacing 0
Set LineHeight 1.1
Set TypingSpeed 18ms
Set Theme { "background": "#07111f", "foreground": "#d9e7f5", "cursor": "#4fddd5", "black": "#101b2a", "red": "#ff7b86", "green": "#6fe8a8", "yellow": "#f5c96b", "blue": "#6da9ff", "magenta": "#d79bff", "cyan": "#4fddd5", "white": "#f5faff", "brightBlack": "#6f8299", "brightRed": "#ff9aa3", "brightGreen": "#8ff0bd", "brightYellow": "#ffda8a", "brightBlue": "#8abaff", "brightMagenta": "#e6b8ff", "brightCyan": "#79eee7", "brightWhite": "#ffffff" }

Type "python3 competition/video/show-evidence.py verify --delay-ms 900"
Enter
Wait+Screen /FAIL-CLOSED DELIVERY CHECK/
Sleep 8s
