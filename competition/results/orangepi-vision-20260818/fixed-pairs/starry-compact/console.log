      profile_samples=$(metric_value profile_samples)
      perf_run_query_errors=$(metric_value perf_run_query_errors)
      total_ms_avg=$(metric_value total_ms_avg)
      total_ms_p95=$(metric_value total_ms_p95)
      letterbox_ms_avg=$(metric_value letterbox_ms_avg)
      letterbox_ms_p95=$(metric_value letterbox_ms_p95)
      rknn_perf_run_ms_avg=$(metric_value rknn_perf_run_ms_avg)
      rknn_perf_run_ms_p95=$(metric_value rknn_perf_run_ms_p95)
      [ "$profile_samples" = 3 ]
      [ "$perf_run_query_errors" = 0 ]
      emit VISION_FIXED_CHECK pair=$pair core=$core_mask \
        samples=3 query_errors=0
      emit VISION_FIXED_VALUE pair=$pair core=$core_mask \
        metric=total_avg value=$total_ms_avg
      emit VISION_FIXED_VALUE pair=$pair core=$core_mask \
        metric=total_p95 value=$total_ms_p95
      emit VISION_FIXED_VALUE pair=$pair core=$core_mask \
        metric=letterbox_avg value=$letterbox_ms_avg
      emit VISION_FIXED_VALUE pair=$pair core=$core_mask \
        metric=letterbox_p95 value=$letterbox_ms_p95
      emit VISION_FIXED_VALUE pair=$pair core=$core_mask \
        metric=npu_avg value=$rknn_perf_run_ms_avg
      emit VISION_FIXED_VALUE pair=$pair core=$core_mask \
        metric=npu_p95 value=$rknn_perf_run_ms_p95
      emit UVC_RKNN_VALIDATE_PASS images=3
    else
      cat "$run_log"
      emit VISION_FIXED_RUN_FAIL pair=$pair core_mask=$core_mask
      exit 1
    fi
    emit VISION_FIXED_RUN_END pair=$pair core_mask=$core_mask
  done
done
