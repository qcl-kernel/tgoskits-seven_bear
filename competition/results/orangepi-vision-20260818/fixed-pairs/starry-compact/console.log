metric_value() {
  metric_key=$1
  for metric_field in $profile_line; do
    case "$metric_field" in
      "$metric_key        printf '%s\n' "${metric_field#*=}"
        return 0
        ;;
    esac
  done
  return 1
}
for pair in 1 2 3 4 5; do
  if [ $((pair % 2)) -eq 1 ]; then
    order=AB
    first=0
    second=all
  else
    order=BA
    first=all
    second=0
  fi
  for core_mask in "$first" "$second"; do
    emit VISION_FIXED_RUN_BEGIN pair=$pair order=$order core_mask=$core_mask
    run_log=/tmp/vision-fixed-$pair-$core_mask.log
    if ./rknn_yolov8_bench \
        --validate-list validation/images.txt \
        --expected validation/expected.txt \
        --min-confidence 25 \
        --profile \
        --core-mask "$core_mask" >"$run_log" 2>&1; then
      profile_line=$(grep '^UVC_RKNN_BENCH_PROFILE_RESULT ' "$run_log")
