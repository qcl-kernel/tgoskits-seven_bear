      echo VISION_FIXED_METRIC pair=$pair core_mask=$core_mask \
        profile_samples=3 perf_run_query_errors=0
      echo VISION_FIXED_METRIC_TOTAL pair=$pair core_mask=$core_mask \
        total_ms_avg=$total_ms_avg total_ms_p95=$total_ms_p95
      echo VISION_FIXED_METRIC_STAGE pair=$pair core_mask=$core_mask \
        letterbox_ms_avg=$letterbox_ms_avg \
        letterbox_ms_p95=$letterbox_ms_p95 \
        rknn_perf_run_ms_avg=$rknn_perf_run_ms_avg \
        rknn_perf_run_ms_p95=$rknn_perf_run_ms_p95
      echo UVC_RKNN_VALIDATE_PASS images=3
    else
      cat "$run_log"
      echo VISION_FIXED_RUN_FAIL pair=$pair core_mask=$core_mask
