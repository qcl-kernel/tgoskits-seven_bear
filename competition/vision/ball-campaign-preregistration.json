      "direction": "lower-is-better",
      "definition": "nearest-rank p95 of stable_at_us minus captured_at_us"
    }
  ],
  "secondary_metrics": [
    {
      "name": "absent_false_motion_rate",
      "definition": "non-HOLD stable actions among absent-ball trials"
    }
  ],
  "evidence_gate": {
